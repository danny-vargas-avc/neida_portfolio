# Copy to .env and fill in for anything other than local development.
# Without DJANGO_SECRET_KEY the fallback is regenerated on every start, which
# silently signs everyone out on each deploy.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-admin-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-admin-domain.com

# Where the front end fetches from. Must be reachable by the browser, because
# uploaded image URLs are built from it.
DJANGO_PUBLIC_BASE_URL=https://your-admin-domain.com

# The site's own address, so the browser is allowed to call the API.
DJANGO_CORS_ALLOWED_ORIGINS=https://neidas-site.com

# Postgres in production; omit entirely to use the local SQLite file.
DATABASE_URL=

# Point at a mounted volume so uploads survive a redeploy.
DJANGO_MEDIA_ROOT=/data/media
