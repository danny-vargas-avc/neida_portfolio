# Copy to etc/docker/.env.production on the VPS. Not committed.

# Generate once and keep it. Without it the fallback regenerates on every start,
# which silently signs Neida out on each deploy.
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=neidarodriguez.com,www.neidarodriguez.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://neidarodriguez.com,https://www.neidarodriguez.com

# The database and uploads live on volumes so a redeploy does not erase them.
DATABASE_URL=sqlite:////data/db.sqlite3
DJANGO_MEDIA_ROOT=/app/media

DJANGO_TIME_ZONE=America/New_York

# Left empty on purpose: the site and the admin share one origin behind nginx,
# so media URLs are relative and CORS never comes into it. Only set these if the
# two are ever served from different domains.
# DJANGO_PUBLIC_BASE_URL=
# DJANGO_CORS_ALLOWED_ORIGINS=

# Shown as the "view site" link inside the admin.
SITE_URL=https://neidarodriguez.com

# Cloudflare reaches this over a tunnel, so nothing needs to be exposed. Bind
# localhost only: graze already has 0.0.0.0:80 on the same box. Useful for
# curling the stack from the VPS itself.
HTTP_BIND=127.0.0.1:8081

# From Cloudflare: Zero Trust -> Networks -> Tunnels -> Create a tunnel. Add a
# public hostname for neidarodriguez.com pointing at http://nginx:80, then paste
# the tunnel's token here. It is a credential — keep it out of git.
CLOUDFLARE_TUNNEL_TOKEN=
